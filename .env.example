# JCO environment template — never commit private or secret keys.
# Configure GEMINI_API_KEY only in the server/hosting secret manager.
GEMINI_API_KEY=""

# Public application origin, if required by the hosting platform.
APP_URL=""
VITE_APP_URL=""

# Both public values must belong to the same Supabase project.
# Missing or partial configuration disables the connection; there is no default project.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Public intake destination registered in private.property_intake_sites.
# Never resolve intake from the signed-in user's active organization.
VITE_PUBLIC_SITE_SLUG=""

# Wompi private keys and integrity/events secrets must NEVER use VITE_ prefixes.
# Payment processing is not enabled by this template.
