# JCO environment template — never commit private or secret keys.
# Configure GEMINI_API_KEY only in the server/hosting secret manager.
GEMINI_API_KEY=""

# Public application origin, if required by the hosting platform.
APP_URL=""
VITE_APP_URL=""

# For an isolated test deployment, set BOTH values for the same test project.
# Leaving both empty uses the default JCO project embedded in src/lib/supabase.ts.
# IMPORTANT: that default is the existing production Supabase project.
# Do not run registration or data-writing tests against production.
# Providing only one value disables the frontend connection rather than
# silently falling back to production.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Wompi private keys and integrity/events secrets must NEVER use VITE_ prefixes.
# Payment processing is not enabled by this template.
