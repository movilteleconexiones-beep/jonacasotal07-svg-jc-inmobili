{
    admin off
    persist_config off
    auto_https off
}

# Railway terminates HTTPS upstream. Railpack serves the Vite build from /app/dist.
:{$PORT:8080} {
    root * /app/dist
    encode zstd gzip
    header X-Content-Type-Options "nosniff"

    # Prefer one public brand URL. Redirect obsolete hostnames only if
    # their DNS and HTTPS already terminate at this service.
    @legacyDomains host inmojco.com app.inmojco.com
    redir @legacyDomains https://www.inmojco.com{uri} 308

    # HTTP canonical is limited to / so individual agency portals are not
    # incorrectly canonicalized to the software marketing homepage.
    @publicHomepage path /
    header @publicHomepage Link "<https://www.inmojco.com/>; rel=\"canonical\""

    # Do not index sign-in, administrator screens or payment callbacks.
    # Keep these routes crawlable: blocking them in robots.txt hides noindex.
    @privateRoutes path /app /app/* /super-admin /super-admin/*
    header @privateRoutes X-Robots-Tag "noindex, nofollow, noarchive"
    @billingReturn query billing=return
    header @billingReturn X-Robots-Tag "noindex, nofollow, noarchive"

    # Only a web-server liveness check. This never claims that Supabase,
    # Storage, or Wompi is healthy; no SPA fallback may impersonate it.
    handle /readyz {
        header Cache-Control "no-store"
        respond "ok" 200
    }

    # Vite uses content-hashed JS/CSS assets. Never rewrite a missing one to
    # index.html (HTML with HTTP 200 is not a valid stylesheet/script).
    @versionedAssets path /assets/*
    handle @versionedAssets {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # G07: legal policy PDFs must exist on disk. An absent/unapproved policy
    # returns a genuine HTTP 404, NEVER SPA index.html with a false HTTP 200.
    # Nothing is published until a signed policy passes the CI release gate.
    @legalDocuments path /politicas /politicas/*
    handle @legalDocuments {
        header Cache-Control "public, max-age=0, must-revalidate"
        file_server
    }

    # Other static files must also return a real 404 when absent.
    @staticFiles path_regexp staticFiles \.(?:css|js|mjs|map|png|jpe?g|svg|webp|gif|woff2?|ttf|ico|json|webmanifest)$
    handle @staticFiles {
        header Cache-Control "public, max-age=0, must-revalidate"
        file_server
    }

    # SPA routes are valid, but HTML cannot be cached across deployments:
    # otherwise an old index.html points to JS/CSS files already removed.
    handle {
        header Cache-Control "no-store, max-age=0, must-revalidate"
        try_files {path} /index.html
        file_server
    }
}
